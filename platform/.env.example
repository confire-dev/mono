# Platform (Astro) — local development
# Copy to .env.local and fill in real values
# .env.local is gitignored — never commit it

# Supabase (get from: Supabase Dashboard → Project Settings → API)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-side only — never expose to browser
SUPABASE_SERVICE_KEY=eyJ...

# Stripe (get from: Stripe Dashboard → Developers → API Keys)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Worker — point to local wrangler dev for development
WORKER_URL=http://localhost:8787
PUBLIC_WORKER_URL=http://localhost:8787
