---
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  bare?: boolean  // hide site nav (auth pages, CLI authorize, processing)
}

const { title, description = 'Confire — AI agent context optimizer', bare = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Confire</title>
    <link rel="icon" type="image/png" href="/brand/confire-bg-transparent-logo-orange.png" />
    <link rel="apple-touch-icon" href="/brand/confire-bg-transparent-logo-orange@2x.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="confire-dot-grid font-sans antialiased text-confire-text">
    {!bare && (
      <header>
        <!-- SiteNav is rendered per-page via React islands -->
        <a href="/" class="sr-only">Confire home</a>
      </header>
    )}
    <main>
      <slot />
    </main>
  </body>
</html>
