---
import Layout from '@/layouts/Layout.astro'

const error = Astro.url.searchParams.get('error')
---

<Layout title="Pricing">
  <div class="flex min-h-svh flex-col items-center justify-center gap-10 p-6 md:p-10">

    {error === 'invalid_plan' && (
      <p class="rounded-md border border-red-500/50 bg-red-500/10 px-4 py-2 text-sm text-red-400">
        That plan is no longer available. Continue on Free or request early access below.
      </p>
    )}

    <div class="text-center">
      <h1 class="text-3xl font-bold text-confire-text">Simple, transparent pricing</h1>
      <p class="mt-2 text-confire-dim">Free local firewall for AI coding agents. Dev opens soon.</p>
    </div>

    <div class="grid w-full max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <!-- Free — available now -->
      <div class="flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6">
        <div>
          <p class="text-sm font-medium text-confire-dim">Free</p>
          <p class="mt-1 text-3xl font-bold text-confire-text">$0</p>
          <p class="text-sm text-confire-dim">/month</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Claude Code, Cursor, VS Code</li>
          <li>✓ Tool Firewall</li>
          <li>✓ Context Firewall</li>
          <li>✓ Built-in guardrails</li>
          <li>✓ Secret redaction</li>
          <li>✓ Injection guard</li>
          <li>✓ Local optimizers</li>
          <li>✓ Basic stats</li>
        </ul>
        <a
          href="/login?plan=free"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full bg-confire-accent px-4 text-sm font-semibold text-confire-white hover:brightness-110"
        >
          Start free
        </a>
      </div>

      <!-- Dev — early access -->
      <div class="relative flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-confire-border-mid bg-confire-card-2 px-3 py-0.5 text-xs font-semibold text-confire-dim">
          Early access
        </span>
        <div>
          <p class="text-sm font-medium text-confire-dim">Dev</p>
          <div class="mt-1 flex items-baseline gap-2">
            <p class="text-3xl font-bold text-confire-text">$10</p>
            <span class="rounded-full bg-confire-card-2 px-2 py-0.5 text-xs font-medium text-confire-dim">/ mo soon</span>
          </div>
          <p class="text-sm text-confire-dim">&nbsp;</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Everything in Free</li>
          <li>✓ Higher remote optimization limits</li>
          <li>✓ Custom dashboard guardrails</li>
          <li>✓ Policy sync</li>
          <li>✓ Firewall + optimization history</li>
          <li>✓ Updated optimizer and rule library</li>
          <li>✓ Top-up credits</li>
        </ul>
        <a
          href="mailto:hello@confire.dev?subject=Dev%20Early%20Access"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full border border-confire-border-mid px-4 text-sm font-semibold text-confire-text hover:bg-confire-hover"
        >
          Request early access
        </a>
      </div>

      <!-- Team — planned -->
      <div class="flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6 opacity-70">
        <div>
          <p class="text-sm font-medium text-confire-dim">Team</p>
          <p class="mt-1 text-3xl font-bold text-confire-text">Planned</p>
          <p class="text-sm text-confire-dim">&nbsp;</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Everything in Dev</li>
          <li>✓ Shared policy management</li>
          <li>✓ Team usage dashboard</li>
          <li>✓ Custom optimizers</li>
          <li>✓ Audit controls</li>
          <li>✓ SSO / SAML</li>
          <li>✓ Priority support</li>
        </ul>
        <a
          href="mailto:hello@confire.dev?subject=Team%20Plan"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full border border-confire-border-mid px-4 text-sm font-semibold text-confire-text hover:bg-confire-hover"
        >
          Join waitlist
        </a>
      </div>

    </div>

    <p class="max-w-lg text-center text-xs text-confire-dim">
      Confire is free while we validate the local firewall.
      Dev early access is opening for power users who want custom rules and higher remote limits.
    </p>

  </div>
</Layout>
