---
import Layout from '@/layouts/Layout.astro'

const error = Astro.url.searchParams.get('error')
---

<Layout title="Pricing">
  <div class="flex min-h-svh flex-col items-center justify-center gap-10 p-6 md:p-10">

    {error === 'invalid_plan' && (
      <p class="rounded-md border border-red-500/50 bg-red-500/10 px-4 py-2 text-sm text-red-400">
        That plan is no longer available. You can continue on Free or choose another plan below.
      </p>
    )}

    <div class="text-center">
      <h1 class="text-3xl font-bold text-confire-text">Simple, transparent pricing</h1>
      <p class="mt-2 text-confire-dim">Start free. Upgrade when you need more.</p>
    </div>

    <div class="flex items-center gap-3 rounded-full border border-confire-border-mid bg-confire-card-2 p-1">
      <button
        id="btn-monthly"
        class="rounded-full px-4 py-1.5 text-sm font-medium transition-colors bg-confire-card text-confire-text shadow"
        onclick="setBilling('monthly')"
      >
        Monthly
      </button>
      <button
        id="btn-annual"
        class="rounded-full px-4 py-1.5 text-sm font-medium transition-colors text-confire-dim hover:text-confire-text"
        onclick="setBilling('annual')"
      >
        Annual <span class="ml-1 text-xs font-semibold text-confire-green">Save ~20%</span>
      </button>
    </div>

    <div class="grid w-full max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-4">

      <div class="flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6">
        <div>
          <p class="text-sm font-medium text-confire-dim">Free</p>
          <p class="mt-1 text-3xl font-bold text-confire-text">$0</p>
          <p class="text-sm text-confire-dim">/month</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Claude Code hook</li>
          <li>✓ Local CLI</li>
          <li>✓ 4 local optimizers</li>
          <li>✓ 500 remote requests/mo</li>
          <li>✓ Universal fallback optimizer</li>
          <li>✓ Basic token savings stats</li>
        </ul>
        <a
          href="/login?plan=free"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full border border-confire-border-mid px-4 text-sm font-semibold text-confire-text hover:bg-confire-hover"
        >
          Get started free
        </a>
      </div>

      <div class="relative flex flex-col gap-4 rounded-lg border-2 border-confire-accent bg-confire-card p-6">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-confire-accent px-3 py-0.5 text-xs font-semibold text-confire-white">
          Most popular
        </span>
        <div>
          <p class="text-sm font-medium text-confire-dim">Dev</p>
          <p class="mt-1 text-3xl font-bold text-confire-text">
            <span data-monthly>$10</span>
            <span data-annual class="hidden">$95</span>
          </p>
          <p class="text-sm text-confire-dim">
            <span data-monthly>/month</span>
            <span data-annual class="hidden">/year <span class="text-xs text-confire-green">(~$7.92/mo)</span></span>
          </p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Everything in Free</li>
          <li>✓ 5,000 remote requests/mo</li>
          <li>✓ 13 source-specific optimizers</li>
          <li>✓ Remote optimizer updates</li>
          <li>✓ Larger input payloads</li>
          <li>✓ Optimization history</li>
          <li>✓ Early access to new adapters</li>
        </ul>
        <a
          data-monthly
          href="/login?plan=dev"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full bg-confire-accent px-4 text-sm font-semibold text-confire-white hover:brightness-110"
        >
          Start Dev plan
        </a>
        <a
          data-annual
          href="/login?plan=dev_annual"
          class="hidden mt-auto inline-flex h-10 items-center justify-center rounded-full bg-confire-accent px-4 text-sm font-semibold text-confire-white hover:brightness-110"
        >
          Start Dev annual
        </a>
      </div>

      <div class="flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6">
        <div class="flex items-start justify-between gap-2">
          <p class="text-sm font-medium text-confire-dim">Pro</p>
          <span class="rounded-full bg-confire-card-2 px-2 py-0.5 text-xs font-medium text-confire-dim whitespace-nowrap">
            Heavy sessions
          </span>
        </div>
        <div>
          <p class="mt-1 text-3xl font-bold text-confire-text">
            <span data-monthly>$20</span>
            <span data-annual class="hidden">$195</span>
          </p>
          <p class="text-sm text-confire-dim">
            <span data-monthly>/month</span>
            <span data-annual class="hidden">/year <span class="text-xs text-confire-green">(~$16.25/mo)</span></span>
          </p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Everything in Dev</li>
          <li>✓ Unlimited fair-use remote requests*</li>
          <li>✓ Session Memory Guard</li>
          <li>✓ PreCompact context optimizer</li>
          <li>✓ Local memory packs</li>
          <li>✓ Priority optimizer updates</li>
          <li>✓ Export data</li>
        </ul>
        <a
          data-monthly
          href="/login?plan=pro"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full bg-confire-accent px-4 text-sm font-semibold text-confire-white hover:brightness-110"
        >
          Go Pro
        </a>
        <a
          data-annual
          href="/login?plan=pro_annual"
          class="hidden mt-auto inline-flex h-10 items-center justify-center rounded-full bg-confire-accent px-4 text-sm font-semibold text-confire-white hover:brightness-110"
        >
          Go Pro annual
        </a>
      </div>

      <div class="flex flex-col gap-4 rounded-lg border border-confire-border-mid bg-confire-card p-6">
        <div>
          <p class="text-sm font-medium text-confire-dim">Enterprise</p>
          <p class="mt-1 text-3xl font-bold text-confire-text">Custom</p>
          <p class="text-sm text-confire-dim">&nbsp;</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-confire-dim">
          <li>✓ Self-hosted deployment</li>
          <li>✓ Local-only optimizer mode</li>
          <li>✓ Team policy controls</li>
          <li>✓ Custom optimizers</li>
          <li>✓ Audit / logging controls</li>
          <li>✓ SSO / SAML (roadmap)</li>
          <li>✓ Priority support</li>
        </ul>
        <a
          href="mailto:hello@confire.dev"
          class="mt-auto inline-flex h-10 items-center justify-center rounded-full border border-confire-border-mid px-4 text-sm font-semibold text-confire-text hover:bg-confire-hover"
        >
          Contact us
        </a>
      </div>

    </div>

    <p class="text-xs text-confire-dim">
      *Unlimited fair-use — monthly token cap and per-minute rate limits apply.
      <a href="/docs/rate-limits" class="underline underline-offset-2 hover:text-confire-text">See limits →</a>
    </p>

  </div>
</Layout>

<script>
  function setBilling(mode: 'monthly' | 'annual') {
    const isAnnual = mode === 'annual'

    const btnMonthly = document.getElementById('btn-monthly')!
    const btnAnnual  = document.getElementById('btn-annual')!
    btnMonthly.className = isAnnual
      ? 'rounded-full px-4 py-1.5 text-sm font-medium transition-colors text-confire-dim hover:text-confire-text'
      : 'rounded-full px-4 py-1.5 text-sm font-medium transition-colors bg-confire-card text-confire-text shadow'
    btnAnnual.className = isAnnual
      ? 'rounded-full px-4 py-1.5 text-sm font-medium transition-colors bg-confire-card text-confire-text shadow'
      : 'rounded-full px-4 py-1.5 text-sm font-medium transition-colors text-confire-dim hover:text-confire-text'

    document.querySelectorAll('[data-monthly]').forEach(el => {
      el.classList.toggle('hidden', isAnnual)
    })
    document.querySelectorAll('[data-annual]').forEach(el => {
      el.classList.toggle('hidden', !isAnnual)
    })
  }
</script>
