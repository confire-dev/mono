---
import Layout from '@/layouts/Layout.astro'

// Fetch latest release at build time (SSR: refreshes on each request)
let version = 'latest'
let publishedAt = ''
let changelog = ''

try {
  const base = import.meta.env.SITE ?? 'https://confire.dev'
  const res = await fetch(`${base}/api/releases/latest`)
  if (res.ok) {
    const data = await res.json()
    version     = data.version ?? 'latest'
    publishedAt = data.publishedAt
      ? new Date(data.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
      : ''
    changelog = data.changelog ?? ''
  }
} catch {
  // fall back to 'latest' label
}
---

<Layout
  title="Install Confire"
  description="Install the Confire CLI on macOS or Linux — curl installer, Homebrew, or direct download."
>
  <div class="max-w-3xl mx-auto px-6 py-16 font-sans">

    <div class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-confire-text mb-2">
        Install Confire
      </h1>
      <div class="flex items-center gap-3 text-sm text-confire-muted">
        <span class="inline-flex items-center gap-1.5 bg-confire-surface border border-confire-border rounded-full px-3 py-0.5 font-mono text-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
          {version}
        </span>
        {publishedAt && <span>Released {publishedAt}</span>}
      </div>
    </div>

    <!-- Quick install -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-confire-text mb-4">Quick install</h2>
      <p class="text-confire-muted text-sm mb-4">
        Works on macOS (Intel + Apple Silicon) and Linux (x86_64 + arm64).
        The script detects your platform, downloads the right binary, verifies the checksum, and installs to <code class="font-mono text-xs">/usr/local/bin</code>.
      </p>
      <div class="bg-confire-surface border border-confire-border rounded-lg p-4 font-mono text-sm text-confire-text overflow-x-auto">
        curl -fsSL https://raw.githubusercontent.com/confire-ai/mono/main/install.sh | sh
      </div>
      <p class="text-xs text-confire-muted mt-2">
        To pin a specific version: <code class="font-mono">... | sh -s -- --version {version}</code>
      </p>
    </section>

    <!-- Homebrew -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-confire-text mb-4">Homebrew (macOS / Linux)</h2>
      <div class="bg-confire-surface border border-confire-border rounded-lg p-4 font-mono text-sm text-confire-text space-y-1 overflow-x-auto">
        <div>brew tap confire-ai/confire</div>
        <div>brew install confire</div>
      </div>
      <p class="text-xs text-confire-muted mt-2">
        Upgrade later with <code class="font-mono">brew upgrade confire</code>.
      </p>
    </section>

    <!-- Direct download -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-confire-text mb-4">Direct download</h2>
      <p class="text-confire-muted text-sm mb-4">
        Download the pre-built binary for your platform from the
        <a
          href={`https://github.com/confire-ai/mono/releases/tag/${version}`}
          class="text-confire-accent underline underline-offset-2"
          target="_blank"
          rel="noopener noreferrer"
        >
          {version} release
        </a>.
      </p>
      <div class="overflow-x-auto rounded-lg border border-confire-border">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-confire-surface border-b border-confire-border">
              <th class="text-left px-4 py-2.5 font-medium text-confire-muted">Platform</th>
              <th class="text-left px-4 py-2.5 font-medium text-confire-muted">Binary</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-confire-border font-mono text-xs text-confire-text">
            {[
              ['macOS (Apple Silicon)', 'confire_darwin_arm64'],
              ['macOS (Intel)',         'confire_darwin_amd64'],
              ['Linux (x86_64)',        'confire_linux_amd64'],
              ['Linux (arm64)',         'confire_linux_arm64'],
            ].map(([label, filename]) => (
              <tr>
                <td class="px-4 py-2.5 font-sans text-confire-muted">{label}</td>
                <td class="px-4 py-2.5">
                  <a
                    href={`https://github.com/confire-ai/mono/releases/download/${version}/${filename}`}
                    class="text-confire-accent hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {filename}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-confire-muted mt-2">
        SHA-256 checksums:
        <a
          href={`https://github.com/confire-ai/mono/releases/download/${version}/confire_checksums.txt`}
          class="text-confire-accent underline underline-offset-2 font-mono"
          target="_blank"
          rel="noopener noreferrer"
        >
          confire_checksums.txt
        </a>
      </p>
    </section>

    <!-- After install -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold text-confire-text mb-4">After installing</h2>
      <div class="bg-confire-surface border border-confire-border rounded-lg p-4 font-mono text-sm text-confire-text space-y-1 overflow-x-auto">
        <div><span class="text-confire-muted"># Install Claude Code hooks</span></div>
        <div>confire setup</div>
        <div class="pt-2"><span class="text-confire-muted"># Connect your account</span></div>
        <div>confire login</div>
        <div class="pt-2"><span class="text-confire-muted"># Check status</span></div>
        <div>confire status</div>
      </div>
    </section>

    <!-- Changelog snippet -->
    {changelog && (
      <section class="mb-12">
        <h2 class="text-lg font-semibold text-confire-text mb-4">What's new in {version}</h2>
        <div class="prose prose-sm prose-invert max-w-none text-confire-muted bg-confire-surface border border-confire-border rounded-lg p-6">
          <div set:html={changelog
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/\n/g, '<br/>')} />
        </div>
      </section>
    )}

  </div>
</Layout>
