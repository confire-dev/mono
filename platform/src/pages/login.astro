---
import AppLayout from '@/layouts/AppLayout.astro'
import { AuthForm } from '@/components/auth/AuthForm'
import { normalizePlanIntent } from '@/lib/plan-intent'

const planIntent = normalizePlanIntent(Astro.url.searchParams.get('plan'))
const next = Astro.url.searchParams.get('next') ?? ''
---

<AppLayout title="Sign in">
  <AuthForm client:only="react" planIntent={planIntent} next={next} />
</AppLayout>
