---
// Profile completion — shown once after first authentication
// if the user has no name in the profiles table.
export const prerender = true
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <title>Welcome — Confire</title>
  </head>
  <body class="flex items-center justify-center min-h-screen p-4">
    <div id="root" class="w-full max-w-sm" />

    <script type="module">
      import { createElement } from 'react'
      import { createRoot }    from 'react-dom/client'
      import { createBrowserClient } from '../lib/supabase.ts'
      import { ProfileCompletion } from '../components/auth/ProfileCompletion.tsx'

      const supabase = createBrowserClient()
      const params   = new URLSearchParams(window.location.search)
      const nextUrl  = params.get('next') ?? '/dashboard'

      const { data: { user } } = await supabase.auth.getUser()
      if (!user) { window.location.href = '/login'; return }

      createRoot(document.getElementById('root')).render(
        createElement(ProfileCompletion, {
          email:   user.email ?? '',
          userId:  user.id,
          nextUrl,
        })
      )
    </script>
  </body>
</html>
