---
import AppLayout from '@/layouts/AppLayout.astro'
import { BillingSuccess } from '@/components/app/BillingPages'
import { createSupabaseServer } from '@/lib/supabase'

const supabase = createSupabaseServer(Astro.request, Astro.cookies)
const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

const { data: profile } = await supabase
  .from('profiles')
  .select('plan, subscription_status')
  .eq('id', user.id)
  .maybeSingle()

const isActive = profile?.subscription_status === 'active' && profile?.plan !== 'free'
---

<AppLayout title="Payment received">
  <BillingSuccess client:only="react" isActive={isActive} />
</AppLayout>
