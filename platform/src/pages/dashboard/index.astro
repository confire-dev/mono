---
import Layout from '@/layouts/Layout.astro'
import { DashboardPage } from '@/components/dashboard/DashboardPage'
import { DashboardOverview } from '@/components/dashboard/DashboardOverview'
---

<Layout title="Dashboard" bare>
  <!--
    client:only="react" — skips Astro SSR entirely.
    DashboardPage resolves auth then renders the shell + content in the browser.
  -->
  <DashboardPage client:only="react" title="Dashboard" currentPath="/dashboard">
    <DashboardOverview userId="" />
  </DashboardPage>
</Layout>
