        { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Context" }] },
        { "type": "paragraph", "content": [{ "type": "text", "text": "We need to implement OAuth 2.0 with PKCE for the platform's authentication flow. This will replace the current session-cookie approach for third-party integrations." }] },
        { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Acceptance Criteria" }] },
        { "type": "bulletList", "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "OAuth 2.0 authorization code flow with PKCE implemented" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Token refresh works automatically before expiry" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Revocation endpoint called on logout" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "All new code covered by unit tests (>80% coverage)" }] }] }
        ]},
        { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Technical Notes" }] },
        { "type": "paragraph", "content": [{ "type": "text", "text": "Use the " }, { "type": "text", "text": "pkce-challenge", "marks": [{ "type": "code" }] }, { "type": "text", "text": " library for code verifier generation. Store tokens in httpOnly cookies, not localStorage." }] }
      ]
    },
